# systemd unit — ndlaw-mcp over Streamable HTTP, bound to localhost.
# Install to /etc/systemd/system/ndlaw-mcp.service (see deploy/SETUP.md).
#
# Adjust User/paths if you don't use the /srv/ndcourts layout from SETUP.md.

[Unit]
Description=ndlaw-mcp (MCP server, Streamable HTTP)
After=network-online.target
Wants=network-online.target

[Service]
User=ndcourts
Group=ndcourts
WorkingDirectory=/srv/ndcourts/ndlaw-mcp

# Transport + bind. Host stays on localhost — only Caddy is public.
Environment=NDLAW_TRANSPORT=http
Environment=NDLAW_HOST=127.0.0.1
Environment=NDLAW_PORT=8000
Environment=NDLAW_DB=/srv/ndcourts/opinions.db

# Per-call tool log (tool name, timing, size, session, client, and the
# `citation` argument only — never free text or results; JT 2026-11-07). LogsDirectory= creates /var/log/ndlaw-mcp owned by
# User= and keeps it writable under ProtectSystem=strict. Rotated by
# deploy/logrotate-ndlaw-mcp; read by deploy/anti-scrape/daily-traffic-report.py.
LogsDirectory=ndlaw-mcp
Environment=NDLAW_TOOLLOG=/var/log/ndlaw-mcp/toolcalls.jsonl
# Corpus-issue reports filed by clients through report_corpus_issue (one JSON
# line each; read by scripts/corpus_reports.py on the dev machine). Same dir,
# same rotation file.
Environment=NDLAW_REPORTLOG=/var/log/ndlaw-mcp/corpus-reports.jsonl

ExecStart=/srv/ndcourts/ndlaw-mcp/.venv/bin/ndlaw-mcp
Restart=on-failure
RestartSec=2

# --- Hardening ---
# The app only READS opinions, but SQLite WAL mode writes -wal/-shm files
# next to the DB, so the DB directory must stay writable: hence the
# ReadWritePaths exception under ProtectSystem=strict.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/ndcourts
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
